-returns jsonb
-language plpgsql
-security definer
-set search_path = public
-as $$
-declare
-    v_user_id uuid := auth.uid();
-begin
-    update public.missions
-    set status = 'expired'
-    where status in ('open', 'full', 'paused_by_creator')
-      and ends_at <= now();
