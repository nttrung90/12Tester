-    v_window_start := ((p_date - 30)::timestamp at time zone 'Asia/Ho_Chi_Minh');
-
-    -- K: app của user đang open, hoặc paused do chính sách vắng mặt.
-    -- App phải được tạo trước 00:00 VN của ngày chấm để bắt đầu tính từ ngày mai.
-    select count(*) into v_k
-    from public.campaigns c
-    where c.owner_id = p_user_id
-      and (
-          c.status = 'open'
-          or (c.status = 'paused' and c.paused_reason = 'owner_inactive')
-      )
-      and c.created_at < v_day_start
-      and c.created_at > v_window_start;
-
-    -- A: app open không thuộc sở hữu user, đã tồn tại trong ngày chấm.
-    select count(*) into v_a
-    from public.campaigns c
-    where c.status = 'open'
-      and c.owner_id <> p_user_id
-      and c.created_at < v_next_day_start
-      and c.created_at > v_window_start;
-
-    -- D: số app khác nhau user đã test trong ngày.
-    select count(distinct campaign_id) into v_d
-    from (
-        select ci.campaign_id
-        from public.checkins ci
-        join public.campaigns c on c.id = ci.campaign_id
-        where ci.user_id = p_user_id
-          and ci.checkin_date = p_date
-          and c.owner_id <> p_user_id
-          -- Checkin sinh ra từ report đã được đếm ở nhánh tester_reports.
-          -- Bỏ qua để report cũ được duyệt hôm nay không tính thêm một lượt.
-          and (
-              ci.note is null
-              or (
-                  ci.note not like 'Đã kiểm thử%'
-                  and ci.note not like 'Đã nộp kết quả%'
-                  and ci.note not like '%tạm tính%'
-                  and ci.note not like 'Tự động duyệt%'
-                  and ci.note not like '%Tự động duyệt%'
-                  and ci.note not like '%chủ app duyệt%'
-              )
-          )
-
-        union
-
-        select tr.campaign_id
-        from public.tester_reports tr
-        join public.campaigns c on c.id = tr.campaign_id
-        where tr.user_id = p_user_id
-          and (tr.created_at at time zone 'Asia/Ho_Chi_Minh')::date = p_date
-          and tr.status in ('pending', 'approved')
-          and c.owner_id <> p_user_id
-    ) t;
-
-    -- Login lấy từ lịch sử theo ngày (live/finalized row), fallback last_login_date.
-    select (v_last_login = p_date) or exists (
-        select 1
-        from public.user_daily_tasks t
-        where t.user_id = p_user_id
-          and t.task_date = p_date
-          and t.logged_in = true
-    ) into v_logged_in;
-
-    v_policy := public.get_daily_task_policy(p_date);
-    v_required := v_policy.tests_per_active_app * v_k;
-    v_effective := least(v_required, v_a);
-    v_mode := case when v_k > 0 then 'owner' else 'member' end;
-
-    if v_exempt then
-        v_met := true;
-    elsif v_k > 0 then
-        v_met := v_d >= v_effective;
-    else
-        v_met := v_logged_in or v_d > 0;
-    end if;
-
-    v_next_pct := case
-        when v_streak <= 0 then 1
-        when v_streak = 1 then 2
-        when v_streak = 2 then 5
-        else 10
-    end;
-
-    return jsonb_build_object(
-        'status_date', to_char(p_date, 'YYYY-MM-DD'),
-        'mode', v_mode,
-        'active_app_count', v_k,
-        'required_tests', v_required,
-        'available_apps', v_a,
-        'effective_required_tests', v_effective,
-        'completed_tests', v_d,
-        'logged_in_today', v_logged_in,
-        'is_penalty_exempt', v_exempt,
-        'missed_streak', v_streak,
-        'next_penalty_percent', v_next_pct,
-        'met', v_met
-    );
-end;
-$$;
-
-create or replace function public._apply_daily_inactivity_penalty(p_eval date)
-returns void
-language plpgsql
-security definer
-set search_path = public
-as $$
-declare
-    v_today date := (now() at time zone 'Asia/Ho_Chi_Minh')::date;
-    v_policy public.daily_task_policies;
-    r record;
-    v_status jsonb;
-    v_met boolean;
-    v_mode text;
-    v_required int;
-    v_effective int;
-    v_completed int;
-    v_logged_in boolean;
-    v_prev_streak int;
-    v_new_streak int;
-    v_pct numeric;
-    v_ratio numeric;
-    v_deduction int;
-    v_new_balance int;
-    v_rows int;
-    v_note text;
-begin
-    if p_eval is null then
-        return;
-    end if;
-
-    -- Chống chạy song song; unique key vẫn là lớp bảo vệ cuối.
-    perform pg_advisory_xact_lock(hashtextextended('daily_inactivity_penalty', 0));
-    v_policy := public.get_daily_task_policy(p_eval);
-
-    for r in
-        select p.id, p.credits, p.daily_missed_streak
-        from public.profiles p
-        where p.created_at < (p_eval::timestamp at time zone 'Asia/Ho_Chi_Minh')
-          and lower(p.role) not in ('admin', 'moderator')
-        for update of p
-    loop
-        if exists (
-            select 1
-            from public.user_daily_tasks t
-            where t.user_id = r.id
-              and t.task_date = p_eval
-              and t.finalized_at is not null
-        ) then
-            continue;
-        end if;
-
-        v_status := public.get_daily_task_status(r.id, p_eval);
-        if v_status is null then
-            continue;
-        end if;
-
-        v_met := coalesce((v_status ->> 'met')::boolean, false);
-        v_mode := coalesce(v_status ->> 'mode', 'member');
-        v_required := coalesce((v_status ->> 'required_tests')::int, 0);
-        v_effective := coalesce((v_status ->> 'effective_required_tests')::int, 0);
-        v_completed := coalesce((v_status ->> 'completed_tests')::int, 0);
-        v_logged_in := coalesce((v_status ->> 'logged_in_today')::boolean, false);
-
-        -- Lấy streak từ row finalized gần nhất, không dùng profile hiện tại:
-        -- user có thể đã hoàn thành hôm nay trước 00:05 và profile đã reset 0.
-        select coalesce(
-            (select t.missed_streak
-             from public.user_daily_tasks t
-             where t.user_id = r.id
-               and t.task_date < p_eval
-               and t.finalized_at is not null
-             order by t.task_date desc
-             limit 1),
-            r.daily_missed_streak,
-            0
-        ) into v_prev_streak;
-
-        v_new_streak := case when v_met then 0 else v_prev_streak + 1 end;
-
-        if v_met then
-            v_deduction := 0;
-        else
-            v_pct := case
-                when v_new_streak = 1 then 0.01
-                when v_new_streak = 2 then 0.02
-                when v_new_streak = 3 then 0.05
-                else 0.10
-            end;
-
-            if v_mode = 'owner' and v_effective > 0 then
-                v_ratio := greatest(
-                    0,
-                    least(
-                        1,
-                        (v_effective - v_completed)::numeric / v_effective::numeric
-                    )
-                );
-            elsif v_mode = 'member' then
-                v_ratio := case when v_logged_in then 0 else 1 end;
-            else
-                v_ratio := 0;
-            end if;
-
-            if v_ratio <= 0 then
-                v_deduction := 0;
-            else
-                v_deduction := least(
-                    r.credits,
-                    greatest(1, ceil(r.credits * v_pct * v_ratio)::int)
-                );
-            end if;
-        end if;
-
-        v_new_balance := r.credits - v_deduction;
-
-        insert into public.user_daily_tasks as t (
-            user_id, task_date, mode, active_app_count, required_tests,
-            effective_required_tests, available_apps, completed_tests,
-            logged_in, is_exempt, met, missed_streak, penalty_credits, finalized_at,
-            policy_id, tests_per_active_app
-        ) values (
-            r.id, p_eval, v_mode,
-            coalesce((v_status ->> 'active_app_count')::int, 0),
-            v_required,
-            v_effective,
-            coalesce((v_status ->> 'available_apps')::int, 0),
-            v_completed,
-            v_logged_in,
-            false,
-            v_met,
-            v_new_streak,
-            v_deduction,
-            now(),
-            v_policy.id,
-            v_policy.tests_per_active_app
-        )
-        on conflict (user_id, task_date) do update
-        set mode = excluded.mode,
-            active_app_count = excluded.active_app_count,
-            required_tests = excluded.required_tests,
-            effective_required_tests = excluded.effective_required_tests,
-            available_apps = excluded.available_apps,
-            completed_tests = excluded.completed_tests,
-            logged_in = excluded.logged_in,
-            is_exempt = excluded.is_exempt,
-            met = excluded.met,
-            missed_streak = excluded.missed_streak,
-            penalty_credits = excluded.penalty_credits,
-            finalized_at = now(),
-            policy_id = excluded.policy_id,
-            tests_per_active_app = excluded.tests_per_active_app
-        where t.finalized_at is null;
-
-        get diagnostics v_rows = row_count;
-        if v_rows = 0 then
-            continue;
-        end if;
-
-        update public.profiles
-        set credits = v_new_balance,
-            daily_missed_streak = v_new_streak
-        where id = r.id;
-
-        if v_deduction > 0 then
-            if v_mode = 'owner' then
-                v_note := format(
-                    'Không đạt chỉ tiêu ngày %s: %s/%s app (thiếu %s). Trừ %s Credit.',
-                    to_char(p_eval, 'DD/MM/YYYY'),
-                    v_completed,
-                    v_effective,
-                    greatest(0, v_effective - v_completed),
-                    v_deduction
-                );
-            else
-                v_note := format(
-                    'Không đăng nhập ngày %s. Trừ %s Credit.',
-                    to_char(p_eval, 'DD/MM/YYYY'),
-                    v_deduction
-                );
-            end if;
-
-            insert into public.credit_logs (user_id, amount, action, note, balance)
-            values (r.id, -v_deduction, 'inactivity_penalty', v_note, v_new_balance);
-        end if;
-
-        if not v_met then
-            insert into public.notifications (user_id, title, message, type, data)
-            values (
-                r.id,
-                'Không đạt nhiệm vụ ngày',
-                case
-                    when v_deduction = 0 and v_mode = 'owner' then format(
-                        'Ngày %s bạn mới test %s/%s app. Số dư hiện tại là 0 nên không trừ Credit, nhưng chuỗi thiếu nhiệm vụ tăng lên %s ngày.',
-                        to_char(p_eval, 'DD/MM/YYYY'),
-                        v_completed,
-                        v_effective,
-                        v_new_streak
-                    )
-                    when v_deduction = 0 then format(
-                        'Ngày %s bạn không mở app. Số dư hiện tại là 0 nên không trừ Credit, nhưng chuỗi thiếu nhiệm vụ tăng lên %s ngày.',
-                        to_char(p_eval, 'DD/MM/YYYY'),
-                        v_new_streak
-                    )
-                    when v_mode = 'owner' then format(
-                        'Ngày %s bạn mới test %s/%s app. Bạn bị trừ %s Credit và chuỗi thiếu nhiệm vụ tăng lên %s ngày.',
-                        to_char(p_eval, 'DD/MM/YYYY'),
-                        v_completed,
-                        v_effective,
-                        v_deduction,
-                        v_new_streak
-                    )
-                    else format(
-                        'Ngày %s bạn không mở app. Bạn bị trừ %s Credit và chuỗi thiếu nhiệm vụ tăng lên %s ngày.',
-                        to_char(p_eval, 'DD/MM/YYYY'),
-                        v_deduction,
-                        v_new_streak
-                    )
-                end,
-                'credit',
-                jsonb_build_object(
-                    'task_date', to_char(p_eval, 'YYYY-MM-DD'),
-                    'penalty_credits', v_deduction
-                )
-            );
-        end if;
-
-        -- Nếu hôm nay đã đạt, reset streak ngay để auto-pause không pause oan.
-        perform public.refresh_daily_completion(r.id, v_today);
-    end loop;
-end;
-$$;
-
-revoke execute on function public.get_daily_task_status(uuid, date),
-    public._apply_daily_inactivity_penalty(date) from public, anon, authenticated;
-grant execute on function public.get_daily_task_status(uuid, date),
-    public._apply_daily_inactivity_penalty(date) to service_role;
-
-notify pgrst, 'reload schema';
-commit;
-
-
--- ===== 043_backend_cleanup_hardening.sql =====
--- ============================================================================
--- 12 Tester — Supabase migration 043: Backend cleanup hardening (R03, R04, R07, R08)
--- Run this in the Supabase Dashboard: SQL Editor > New query > paste > Run.
---
--- Mục tiêu:
---   1. (R03) sync_expired_missions() là helper backend độc lập: tự động chuyển mission
---      hết hạn sang expired; chỉ cấp quyền cho service_role / cron.
---   2. (R03, R07, R08) purge_completed_campaigns():
---      - Dry-run an toàn: chỉ log và scan, KHÔNG gọi sync_expired_missions() hay đổi data.
---      - Chống starvation: ưu tiên campaign không lỗi; áp dụng exponential backoff tăng dần
---        (2 ngày -> 4 ngày -> 8 ngày -> 14 ngày) để 100 campaign lỗi không chặn các campaign khác.
---      - Chống race condition: dùng pg_advisory_xact_lock và for update skip locked;
---        kiểm tra không còn pending report và không có report mới nộp trong 1h qua;
---        đảm bảo không còn mission nào chưa quá hạn ends_at > now().
---   3. (R04, R06) pause_mission / resume_mission:
---      - Giữ nguyên contract lỗi auth/quyền cũ (RAISE EXCEPTION 'PERMISSION_DENIED', v.v.).
---      - Khi mission đã hết hạn (ends_at <= now()), cập nhật status = 'expired' vào DB
---        và trả về JSON có cấu trúc code: 'MISSION_EXPIRED' để không bị rollback UPDATE.
--- ============================================================================
-
--- ============================================================================
--- 1. sync_expired_missions() — Đồng bộ trạng thái mission hết hạn độc lập UI
--- ============================================================================
-
-create or replace function public.sync_expired_missions()
-returns int
-language plpgsql
-security definer
-set search_path = public
-as $$
-declare
-    v_updated int := 0;
-begin
-    update public.missions
-    set status = 'expired'
-    where status in ('open', 'full', 'paused_by_creator')
-      and ends_at <= now();
-
-    get diagnostics v_updated = row_count;
-    return v_updated;
-end;
-$$;
-
-comment on function public.sync_expired_missions() is
-    'Helper backend: tự động chuyển các mission open/full/paused_by_creator đã quá ends_at sang expired. Chỉ cấp quyền service_role/cron.';
-
--- Helper backend an toàn: chỉ service_role được gọi (review point 2)
-revoke all on function public.sync_expired_missions() from public, anon, authenticated;
-grant execute on function public.sync_expired_missions() to service_role;
-
-
--- ============================================================================
--- 2. Sửa pause_mission và resume_mission (R04, review point 6)
--- ============================================================================
-
-create or replace function public.pause_mission(p_mission_id uuid)
-returns jsonb
-language plpgsql
-security definer
-set search_path = public
-as $$
-declare
-    v_user_id uuid := auth.uid();
-    v_mission record;
-begin
-    -- Giữ nguyên contract lỗi auth/quyền cũ
-    if v_user_id is null then
-        raise exception 'Not authenticated';
-    end if;
-
-    select * into v_mission
-    from public.missions
-    where id = p_mission_id
-    for update;
-
-    if v_mission.id is null or v_mission.status = 'deleted' then
-        raise exception 'MISSION_NOT_FOUND';
-    end if;
-
-    if v_mission.creator_id <> v_user_id then
-        raise exception 'PERMISSION_DENIED';
-    end if;
-
-    -- Nếu đã hết hạn: cập nhật DB và trả kết quả JSON có cấu trúc, KHÔNG raise exception
-    -- để lệnh UPDATE status = 'expired' không bị rollback (R04).
-    if v_mission.ends_at <= now() then
-        update public.missions
-        set status = 'expired'
-        where id = p_mission_id
-          and status in ('open', 'full', 'paused_by_creator');
-
-        return jsonb_build_object(
-            'success', false,
-            'code', 'MISSION_EXPIRED',
-            'error', 'MISSION_EXPIRED',
-            'message', 'Nhiệm vụ đã hết hạn lưu hành',
-            'mission_id', p_mission_id,
-            'status', 'expired'
-        );
-    end if;
-
-    if v_mission.status not in ('open', 'full') then
-        raise exception 'MISSION_NOT_OPEN';
-    end if;
-
-    update public.missions
-    set status = 'paused_by_creator'
-    where id = p_mission_id;
-
-    return jsonb_build_object(
-        'success', true,
-        'mission_id', p_mission_id,
-        'status', 'paused_by_creator'
-    );
-end;
-$$;
-
-create or replace function public.resume_mission(p_mission_id uuid)
-returns jsonb
-language plpgsql
-security definer
-set search_path = public
-as $$
-declare
-    v_user_id uuid := auth.uid();
-    v_mission record;
-    v_camp_status text;
-    v_new_status text;
-begin
-    -- Giữ nguyên contract lỗi auth/quyền cũ
-    if v_user_id is null then
-        raise exception 'Not authenticated';
-    end if;
-
-    select * into v_mission
-    from public.missions
-    where id = p_mission_id
-    for update;
-
-    if v_mission.id is null or v_mission.status = 'deleted' then
-        raise exception 'MISSION_NOT_FOUND';
-    end if;
-
-    if v_mission.creator_id <> v_user_id then
-        raise exception 'PERMISSION_DENIED';
-    end if;
-
-    if v_mission.status <> 'paused_by_creator' then
-        raise exception 'MISSION_NOT_PAUSED';
-    end if;
-
-    -- Nếu đã quá hạn: cập nhật DB và trả kết quả JSON có cấu trúc, không rollback UPDATE (R04).
-    if v_mission.ends_at <= now() then
-        update public.missions
-        set status = 'expired'
-        where id = p_mission_id;
-
-        return jsonb_build_object(
-            'success', false,
-            'code', 'MISSION_EXPIRED',
-            'error', 'MISSION_EXPIRED',
-            'message', 'Nhiệm vụ đã hết hạn lưu hành',
-            'mission_id', p_mission_id,
-            'status', 'expired'
-        );
-    end if;
-
-    select status into v_camp_status from public.campaigns where id = v_mission.campaign_id;
-    if v_camp_status is null then
-        raise exception 'CAMPAIGN_NOT_FOUND';
-    end if;
-    if v_camp_status <> 'open' then
-        raise exception 'CAMPAIGN_NOT_OPEN';
-    end if;
-
-    v_new_status := case when v_mission.participant_count >= v_mission.max_participants
-                         then 'full' else 'open' end;
-
-    update public.missions
-    set status = v_new_status
-    where id = p_mission_id;
-
-    return jsonb_build_object(
-        'success', true,
-        'mission_id', p_mission_id,
-        'status', v_new_status
-    );
-end;
-$$;
-
-
--- ============================================================================
--- 3. Cập nhật purge_completed_campaigns() (R03, R07, R08, review points 1, 3, 5)
--- ============================================================================
-
-create or replace function public.purge_completed_campaigns(
-    p_retention_days int default 90,
-    p_dry_run boolean default false,
-    p_batch_size int default 100
-)
-returns int
-language plpgsql
-security definer
-set search_path = public
-as $$
-declare
-    v_days int := greatest(1, coalesce(p_retention_days, 90));
-    v_batch int := greatest(1, least(coalesce(p_batch_size, 100), 1000));
-    v_dry_run boolean := coalesce(p_dry_run, false);
-    v_run_id uuid;
-    v_ids uuid[];
-    v_scanned int := 0;
-    v_deleted int := 0;
-    v_errors jsonb := '[]'::jsonb;
-    v_id uuid;
-    v_row_count int;
-    v_status text;
-    v_stale_pending_count int := 0;
-    v_expired_missions_count int := 0;
-    v_camp_rec record;
-begin
-    -- Khóa chống race condition khi nhiều connection cùng gọi hàm purge (review point 5)
-    perform pg_advisory_xact_lock(hashtextextended('purge_completed_campaigns', 0));
-
-    -- (Review point 1): Dry-run chỉ được log và scan, TUYỆT ĐỐI không gọi sync_expired_missions()
-    -- làm đổi dữ liệu nghiệp vụ. Chỉ gọi khi NOT dry_run.
-    if not v_dry_run then
-        begin
-            v_expired_missions_count := public.sync_expired_missions();
-        exception when others then
-            v_expired_missions_count := -1;
-        end;
-    end if;
-
-    -- Đếm số pending reports quá hạn > 7 ngày để theo dõi backlog (R07)
-    begin
-        select count(*)
-        into v_stale_pending_count
-        from public.tester_reports
-        where status = 'pending'
-          and created_at < now() - interval '7 days';
-    exception when others then
-        v_stale_pending_count := -1;
-    end;
-
-    insert into public.cleanup_runs (job_name, status, details)
-    values (
-        'purge_completed_campaigns',
-        'running',
-        jsonb_build_object(
-            'retention_days', v_days,
-            'batch_size', v_batch,
-            'dry_run', v_dry_run,
-            'expired_missions_synced', v_expired_missions_count,
-            'stale_pending_reports_count', v_stale_pending_count
-        )
-    )
-    returning id into v_run_id;
-
-    begin
-        -- Lọc campaign đủ điều kiện purge:
-        -- 1. status completed/closed/production quá v_days ngày
-        -- 2. không còn pending report
-        -- 3. không có report nộp trong 1h qua (chống race condition khi tester vừa nộp)
