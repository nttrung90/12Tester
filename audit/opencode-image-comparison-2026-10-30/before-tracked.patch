-    -- Nếu đã quá hạn: cập nhật DB và trả kết quả JSON có cấu trúc, không rollback UPDATE (R04).
-    if v_mission.ends_at <= now() then
-        update public.missions
-        set status = 'expired'
-        where id = p_mission_id;
