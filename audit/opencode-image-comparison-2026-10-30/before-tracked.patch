-create or replace function public.approve_tester_report(
-    p_report_id uuid,
-    p_bonus int default 0
-)
-returns jsonb
-language plpgsql
-security definer
-set search_path = public
-as $$
-declare
-    v_caller_id uuid := auth.uid();
-    v_caller_role text;
-    v_report record;
-    v_camp record;
-    -- p_bonus giữ lại trong chữ ký để tương thích client cũ nhưng KHÔNG còn
