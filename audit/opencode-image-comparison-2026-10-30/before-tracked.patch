-        -- 5. M04: Còn hạn ends_at > now() tại thời điểm duyệt theo quy tắc hiện hành
-        select
-            m.id as mission_id,
-            m.creator_id,
-            m.title as mission_title,
-            m.reward_credits,
-            m.campaign_id,
-            mp.id as participant_id,
