-language plpgsql
-security definer
-set search_path = public
-stable
-as $$
-declare
-    v_uid uuid := auth.uid();
-    v_today date := (now() at time zone 'Asia/Ho_Chi_Minh')::date;
-    v_camp public.campaigns%rowtype;
-begin
