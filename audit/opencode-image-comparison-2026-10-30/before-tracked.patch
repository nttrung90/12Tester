+                )
+                req.url.toString().contains("get_campaign_mission") -> jsonResponse("{\"mission\":null}")
+                req.url.toString().contains("push_campaign") -> {
+                    throw java.net.SocketTimeoutException("Connection timed out")
+                }
+                else -> jsonResponse("[]")
+            }
+        }
+        login(c, "userA")
