-drop function if exists public.admin_pause_campaign(uuid, text);
-
-create or replace function public.admin_pause_campaign(
-    p_campaign_id uuid,
-    p_reason text default null
-)
-returns jsonb
-language plpgsql
-security definer
-set search_path = public
