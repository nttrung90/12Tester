-returns jsonb
-language plpgsql
-security definer
-set search_path = public
-as $$
-declare
-    v_user_id uuid := auth.uid();
-    v_report_id uuid;
-    v_today date := (now() at time zone 'Asia/Ho_Chi_Minh')::date;
