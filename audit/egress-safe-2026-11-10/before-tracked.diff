-            raise exception 'INVALID_THUMBNAIL_URL';
-        end if;
-    end if;
-
-    -- Feedback: báo cáo đã duyệt thì giữ nguyên rating, chỉ cho bổ sung comment.
-    insert into public.feedbacks (campaign_id, user_id, rating, comment, updated_at)
