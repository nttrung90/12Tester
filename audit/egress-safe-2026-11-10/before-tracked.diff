-create or replace function public.auto_accept_expired_reports()
-returns int
-language plpgsql
-security definer
-set search_path = public
-as $$
-declare
-    v_report record;
-    v_count int := 0;
-    v_owner_id uuid;
-    v_camp_name text;
-    v_tip int;
-    v_base int;
