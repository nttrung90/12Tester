-create or replace function public.resume_campaign(p_campaign_id uuid)
-returns jsonb
-language plpgsql
-security definer
-set search_path = public
-as $$
-declare
-    v_uid uuid := auth.uid();
-    v_camp record;
-    v_missed int;
-begin
-    if v_uid is null then
-        raise exception 'NOT_AUTHENTICATED';
-    end if;
