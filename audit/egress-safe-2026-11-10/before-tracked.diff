-            update public.tester_reports
-            set status = 'approved',
-                bonus_awarded = 0,
-                reviewed_at = now()
-            where id = v_report.id;
-        else
-            -- Đổi trạng thái duyệt và cộng 2 Credit
-            update public.tester_reports
