[
  {
    "name": "campaigns_owner_id_fkey",
    "relation": "campaigns",
    "definition": "FOREIGN KEY (owner_id) REFERENCES profiles(id) ON DELETE CASCADE"
  },
  {
    "name": "campaigns_status_check",
    "relation": "campaigns",
    "definition": "CHECK ((status = ANY (ARRAY['open'::text, 'closed'::text, 'paused'::text, 'production'::text, 'completed'::text])))"
  },
  {
    "name": "profiles_id_fkey",
    "relation": "profiles",
    "definition": "FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE"
  },
  {
    "name": "tester_reports_campaign_id_fkey",
    "relation": "tester_reports",
    "definition": "FOREIGN KEY (campaign_id) REFERENCES campaigns(id) ON DELETE CASCADE"
  },
  {
    "name": "tester_reports_status_check",
    "relation": "tester_reports",
    "definition": "CHECK ((status = ANY (ARRAY['pending'::text, 'approved'::text, 'rejected'::text])))"
  },
  {
    "name": "tester_reports_user_id_fkey",
    "relation": "tester_reports",
    "definition": "FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE"
  }
